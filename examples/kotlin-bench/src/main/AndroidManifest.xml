<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="org.androidannotations.bench.BenchApp_"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:allowBackup="true">
        <activity
            android:name=".bench.BenchActivity001_"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".bench.BenchService_" />
        <service
            android:name="org.androidannotations.bench.BenchReceiverService_" />
        <activity android:name="org.androidannotations.bench.BenchP1Activity_" />
        <activity android:name="org.androidannotations.bench.BenchAndroidXHost_" />
        <activity android:name="org.androidannotations.bench.BenchSeekKeyActivity_" />
        <activity android:name="org.androidannotations.bench.BenchThreadsActivity_" />
        <activity android:name="org.androidannotations.bench.BenchDataActivity_" />
        <service android:name="org.androidannotations.bench.BenchIntentWork_" />
        <receiver
            android:name="org.androidannotations.bench.BenchBroadcast_"
            android:exported="false">
            <intent-filter>
                <action android:name="org.androidannotations.bench.PING" />
                <data android:scheme="bench" />
            </intent-filter>
        </receiver>
        <provider
            android:name="org.androidannotations.bench.BenchProvider_"
            android:authorities="org.androidannotations.bench.provider"
            android:exported="false" />
    </application>

</manifest>
